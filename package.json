{
  "name": "teams-bot",
  "version": "1.0.3",
  "description": "Microsoft Teams Bot built with TypeScript and Microsoft Bot Framework",
  "main": "dist/index.js",
  "scripts": {
    "backup": "npx tsx scripts/backupTeamsBot.ts",
    "prebuild": "npx tsx scripts/backupTeamsBot.ts",
    "pretest": "npx tsx scripts/backupTeamsBot.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "npx tsx --test tests/*.test.ts",
    "dev": "tsx watch src/index.ts",
    "keep-alive": "./bin/keep-alive",
    "keep-alive:swift": "swift scripts/keep-alive.swift",
    "keep-alive:service-start": "launchctl load ~/Library/LaunchAgents/com.umut.teams-keep-alive.plist",
    "keep-alive:service-stop": "launchctl unload ~/Library/LaunchAgents/com.umut.teams-keep-alive.plist",
    "keep-alive:service-status": "launchctl list | grep teams-keep-alive",
    "present:start": "./scripts/start-presentation-mode.sh",
    "present:stop": "./scripts/stop-presentation-mode.sh"
  },
  "keywords": [
    "teams",
    "bot",
    "botframework",
    "typescript"
  ],
  "author": "11Hopem",
  "license": "UNLICENSED",
  "dependencies": {
    "botbuilder": "^4.23.3",
    "dotenv": "^17.4.2",
    "restify": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/restify": "^8.5.12",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
